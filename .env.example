# ==============================================================================
# Prabhav Portal - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit your real '.env' file with passwords/keys to public repositories!
# ==============================================================================

# Server Port
PORT=3000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri_here

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Default Municipal Admin Credentials (Auto-seeded on server startup)
ADMIN_EMAIL=admin@prabhav.gov
ADMIN_PASSWORD=Admin@123
ADMIN_CREDENTIAL_ID=PRABHAV-ADM-2026

# Google Gemini API Key (Required for AI Waste Classification Assistant)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
